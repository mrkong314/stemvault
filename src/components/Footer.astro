---
import Logo from '~/components/brand/Logo.astro';
import EditToggle from '~/components/nav/EditToggle.astro';
import { SUBJECTS } from '~/data/subjects';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <Logo size={28} />
      <p>Interactive teaching tools and curriculum-aligned resources across Mathematics, Chemistry, Physics and Biology, curated for Years 7 to 12.</p>
    </div>
    <div>
      <h4 class="footer-h">Subjects</h4>
      <ul role="list" class="footer-links">
        {SUBJECTS.map(s => (
          <li><a href={`/resources/${s.slug}`}>{s.name}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <h4 class="footer-h">Site</h4>
      <ul role="list" class="footer-links">
        <li><a href="/resources">Resources</a></li>
        <li><a href="/practice">Practice</a></li>
        <li><a href="/tools">Tools</a></li>
      </ul>
    </div>
    <div>
      <h4 class="footer-h">Disclaimer</h4>
      <p class="footer-small">Embedded applets and linked files come from a mix of original and third-party sources. Original authors are credited where known. Please report errors or attribution issues.</p>
    </div>
  </div>
  <div class="container footer-foot">
    <span>© {year} StemVault</span>
    <EditToggle />
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 4rem;
    border-top: 1px solid var(--line);
    background: var(--paper-warm);
    padding: 3rem 0 1.5rem;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 0.7fr 0.7fr 1.2fr;
    gap: 2.5rem;
  }
  .footer-brand p {
    margin: 1rem 0 0;
    font-size: 0.9rem;
    color: var(--ink-soft);
    max-width: 36ch;
  }
  .footer-h {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--pine);
    margin: 0.4rem 0 0.7rem;
  }
  .footer-links li + li { margin-top: 0.35rem; }
  .footer-links a { color: var(--ink-soft); font-size: 0.92rem; }
  .footer-links a:hover { color: var(--pine); }
  .footer-small {
    font-size: 0.84rem;
    line-height: 1.55;
    color: var(--ink-mute);
    margin: 0;
  }
  .footer-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 2.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line-soft);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }
  @media (max-width: 860px) {
    .footer-grid { grid-template-columns: 1fr 1fr; gap: 2rem; }
  }
  @media (max-width: 520px) {
    .footer-grid { grid-template-columns: 1fr; gap: 1.75rem; }
  }
</style>
