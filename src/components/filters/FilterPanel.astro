---
import { SUBJECT_NAMES } from '~/data/subjects';
import { YEAR_LEVELS } from '~/data/yearLevels';
import { getAllTags } from '~/lib/collections';
import { TYPE_LABEL } from '~/lib/types';

interface Props {
  /** Selector for the items the panel filters (cards or list rows). */
  target: string;
  /** Hide the subject section (e.g., on subject-scoped pages). */
  hideSubject?: boolean;
  /**
   * sidebar: collapsible sections with checkboxes and a searchable tag list.
   * inline:  a compact horizontal chip bar (subject/year/type only).
   */
  variant?: 'sidebar' | 'inline';
}
const { target, hideSubject = false, variant = 'sidebar' } = Astro.props;
const inline = variant === 'inline';
const tags = inline ? [] : await getAllTags();

const COLLAPSE_AFTER = 6;

const subjectOpts = SUBJECT_NAMES.map(n => ({ value: n, label: n }));
const typeOpts = (['applet', 'quiz', 'file', 'video'] as const).map(t => ({ value: t, label: TYPE_LABEL[t] }));
const yearOpts = YEAR_LEVELS.map(y => ({ value: String(y), label: inline ? `Yr ${y}` : `Year ${y}` }));

const sections = [
  ...(hideSubject ? [] : [{ name: 'subject', title: 'Subject', options: subjectOpts }]),
  { name: 'year', title: 'Year level', options: yearOpts },
  { name: 'type', title: 'Type', options: typeOpts },
];
const tagVisible = tags.slice(0, COLLAPSE_AFTER);
const tagOverflow = tags.slice(COLLAPSE_AFTER);
---
{inline ? (
  <div class="filter-inline" data-filter-panel data-target={target} role="group" aria-label="Filter resources">
    {sections.map(s => (
      <div class="inline-group">
        <span class="label-mono inline-title">{s.title}</span>
        <div class="chips">
          {s.options.map(o => (
            <label class="chip">
              <input type="checkbox" name={s.name} value={o.value} />
              <span>{o.label}</span>
            </label>
          ))}
        </div>
      </div>
    ))}
    <div class="inline-foot">
      <span class="filter-count" data-filter-count>-</span>
      <button type="button" class="filter-clear" data-filter-clear>Clear</button>
    </div>
  </div>
) : (
  <aside class="filter-panel card" data-filter-panel data-target={target} aria-label="Filter resources">
    <div class="filter-header">
      <span class="label-mono">Filters</span>
      <button type="button" class="filter-clear" data-filter-clear>Clear</button>
    </div>

    {sections.map(s => {
      const visible = s.options.slice(0, COLLAPSE_AFTER);
      const overflow = s.options.slice(COLLAPSE_AFTER);
      return (
        <details class="filter-section" open>
          <summary>
            <span>{s.title}</span>
            <svg class="chev" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </summary>
          <ul role="list" class="check-list">
            {visible.map(o => (
              <li>
                <label class="check">
                  <input type="checkbox" name={s.name} value={o.value} />
                  <span class="check-box" aria-hidden="true"></span>
                  <span class="check-label">{o.label}</span>
                </label>
              </li>
            ))}
            {overflow.map(o => (
              <li data-check-overflow hidden>
                <label class="check">
                  <input type="checkbox" name={s.name} value={o.value} />
                  <span class="check-box" aria-hidden="true"></span>
                  <span class="check-label">{o.label}</span>
                </label>
              </li>
            ))}
          </ul>
          {overflow.length > 0 && (
            <button type="button" class="show-more" data-show-more data-overflow-count={overflow.length}>
              <span data-more-label>+{overflow.length} more</span>
            </button>
          )}
        </details>
      );
    })}

    <details class="filter-section">
      <summary>
        <span>Tags</span>
        <svg class="chev" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </summary>
      <div class="tag-search">
        <svg class="search-ico" viewBox="0 0 20 20" aria-hidden="true">
          <circle cx="9" cy="9" r="6" fill="none" stroke="currentColor" stroke-width="1.6"/>
          <line x1="13.5" y1="13.5" x2="18" y2="18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
        <input type="search" placeholder="Search tags…" data-tag-search autocomplete="off" aria-label="Search tags" />
      </div>
      <ul role="list" class="check-list" data-tag-list>
        {tagVisible.map(t => (
          <li data-tag-item={t.toLowerCase()}>
            <label class="check">
              <input type="checkbox" name="tag" value={t} />
              <span class="check-box" aria-hidden="true"></span>
              <span class="check-label">{t}</span>
            </label>
          </li>
        ))}
        {tagOverflow.map(t => (
          <li data-tag-item={t.toLowerCase()} data-check-overflow hidden>
            <label class="check">
              <input type="checkbox" name="tag" value={t} />
              <span class="check-box" aria-hidden="true"></span>
              <span class="check-label">{t}</span>
            </label>
          </li>
        ))}
      </ul>
      {tagOverflow.length > 0 && (
        <button type="button" class="show-more" data-show-more data-overflow-count={tagOverflow.length}>
          <span data-more-label>+{tagOverflow.length} more</span>
        </button>
      )}
    </details>

    <div class="filter-foot">
      <span class="filter-count" data-filter-count>-</span>
    </div>
  </aside>
)}

<script>
  import '~/scripts/filters.ts';

  // "+N more" toggle for collapsed option lists.
  document.querySelectorAll<HTMLButtonElement>('[data-show-more]').forEach(btn => {
    btn.addEventListener('click', () => {
      const section = btn.closest('details');
      const overflow = section?.querySelectorAll<HTMLElement>('[data-check-overflow]') ?? [];
      const label = btn.querySelector<HTMLElement>('[data-more-label]');
      if (!overflow.length || !label) return;
      const expanded = btn.dataset.expanded === '1';
      btn.dataset.expanded = expanded ? '' : '1';
      label.textContent = expanded ? `+${btn.dataset.overflowCount} more` : 'Show fewer';
      section?.querySelector<HTMLInputElement>('[data-tag-search]')?.dispatchEvent(new Event('input'));
      if (!section?.querySelector('[data-tag-search]')) overflow.forEach(el => (el.hidden = expanded));
    });
  });

  // Tag-search input filters which tag checkboxes are visible (does not affect resource filtering).
  // While searching, collapsed overflow tags are shown too so every match is reachable.
  document.querySelectorAll<HTMLInputElement>('[data-tag-search]').forEach(input => {
    const section = input.closest('details');
    const list = section?.querySelector<HTMLElement>('[data-tag-list]');
    const more = section?.querySelector<HTMLButtonElement>('[data-show-more]');
    if (!list) return;
    input.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      const expanded = more?.dataset.expanded === '1';
      list.querySelectorAll<HTMLElement>('[data-tag-item]').forEach(item => {
        const t = item.dataset.tagItem ?? '';
        const isOverflow = item.hasAttribute('data-check-overflow');
        const collapsed = isOverflow && !expanded && q === '';
        item.hidden = collapsed || (q !== '' && !t.includes(q));
      });
      if (more) more.hidden = q !== '';
    });
  });
</script>

<style>
  /* Shared */
  .filter-clear {
    background: transparent;
    border: none;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-mute);
  }
  .filter-clear:hover { color: var(--amber); }
  .filter-count {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    color: var(--ink-mute);
  }

  /* Sidebar variant */
  .filter-panel {
    padding: 1rem 1.1rem 0.9rem;
    position: sticky;
    top: calc(var(--header-h) + 1rem);
    max-height: calc(100dvh - var(--header-h) - 2rem);
    overflow-y: auto;
  }
  .filter-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--line-soft);
  }
  .filter-section { border-bottom: 1px solid var(--line-soft); padding: 0.55rem 0; }
  .filter-section:last-of-type { border-bottom: 0; }
  summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    font-size: 0.86rem;
    font-weight: 500;
    padding: 0.3rem 0;
    color: var(--ink);
  }
  summary::-webkit-details-marker { display: none; }
  .chev { width: 14px; height: 14px; color: var(--ink-mute); transition: transform var(--ease); }
  details[open] .chev { transform: rotate(180deg); }

  .check-list { margin: 0.25rem 0 0; }
  .check {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.28rem 0;
    cursor: pointer;
    font-size: 0.86rem;
    color: var(--ink-soft);
  }
  .check input { position: absolute; opacity: 0; width: 0; height: 0; }
  .check-box {
    width: 15px; height: 15px;
    border: 1.5px solid var(--line);
    border-radius: 4px;
    background: var(--surface);
    flex-shrink: 0;
    position: relative;
    transition: background var(--ease), border-color var(--ease);
  }
  .check:hover .check-box { border-color: var(--pine); }
  .check input:checked + .check-box { background: var(--pine); border-color: var(--pine); }
  .check input:checked + .check-box::after {
    content: '';
    position: absolute;
    left: 4px; top: 1px;
    width: 4px; height: 8px;
    border: solid #fff;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }
  .check input:focus-visible + .check-box { outline: 2px solid var(--pine); outline-offset: 2px; }
  .check-label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  .show-more {
    background: transparent;
    border: none;
    padding: 0.3rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.06em;
    color: var(--pine);
  }
  .show-more:hover { color: var(--amber); }

  .tag-search {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.3rem 0.65rem;
    margin: 0.3rem 0 0.4rem;
    background: var(--paper);
  }
  .tag-search:focus-within { border-color: var(--pine); }
  .search-ico { width: 13px; height: 13px; color: var(--ink-mute); flex-shrink: 0; }
  .tag-search input {
    flex: 1; min-width: 0;
    border: none; background: transparent; outline: none;
    font: inherit; font-size: 0.82rem; color: var(--ink);
  }
  .filter-foot { padding-top: 0.6rem; border-top: 1px solid var(--line-soft); }

  /* Inline variant */
  .filter-inline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    padding: 0.8rem 1rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    margin-bottom: 1.25rem;
  }
  .inline-group { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
  .inline-title { flex-shrink: 0; }
  .chips { display: flex; gap: 0.3rem; flex-wrap: wrap; }
  .chip { position: relative; cursor: pointer; }
  .chip input { position: absolute; opacity: 0; width: 0; height: 0; }
  .chip span {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.04em;
    padding: 0.28rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--ink-soft);
    background: var(--paper);
    transition: background var(--ease), color var(--ease), border-color var(--ease);
  }
  .chip:hover span { border-color: var(--pine); color: var(--pine); }
  .chip input:checked + span { background: var(--pine); border-color: var(--pine); color: #fff; }
  .chip input:focus-visible + span { outline: 2px solid var(--pine); outline-offset: 2px; }
  .inline-foot { margin-left: auto; display: flex; gap: 0.9rem; align-items: center; }
</style>
