---
import Logo from '~/components/brand/Logo.astro';
import SearchBar from './SearchBar.astro';
import EditToggle from './EditToggle.astro';

const path = Astro.url.pathname;
const isActive = (prefix: string) => path === prefix || path.startsWith(prefix + '/');
const links = [
  { href: '/', label: 'Home', active: path === '/' },
  { href: '/resources', label: 'Resources', active: isActive('/resources') },
  { href: '/tools', label: 'Tools', active: isActive('/tools') },
];
---
<header class="site-header" id="site-header">
  <div class="container-wide header-inner">
    <div class="header-brand">
      <Logo size={30} />
    </div>

    <nav class="primary-nav" aria-label="Primary">
      {links.map(l => (
        <a href={l.href} class:list={['nav-link', { active: l.active }]} aria-current={l.active ? 'page' : undefined}>
          {l.label}
        </a>
      ))}
    </nav>

    <div class="header-tools">
      <SearchBar />
      <EditToggle />
      <button
        type="button"
        class="menu-btn"
        id="svault-menu-btn"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="svault-mobile-nav"
      >
        <span class="menu-bar" aria-hidden="true"></span>
        <span class="menu-bar" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <nav class="mobile-nav" id="svault-mobile-nav" aria-label="Primary (mobile)" hidden>
    <div class="container-wide mobile-inner">
      {links.map(l => (
        <a href={l.href} class:list={['mobile-link', { active: l.active }]}>{l.label}</a>
      ))}
    </div>
  </nav>
</header>

<script>
  const header = document.getElementById('site-header');
  const btn = document.getElementById('svault-menu-btn');
  const nav = document.getElementById('svault-mobile-nav');
  if (header && btn && nav) {
    const set = (open: boolean) => {
      nav.hidden = !open;
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      header.classList.toggle('menu-open', open);
    };
    btn.addEventListener('click', () => set(nav.hidden));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !nav.hidden) set(false);
    });
    document.addEventListener('click', (e) => {
      if (nav.hidden) return;
      if (!header.contains(e.target as Node)) set(false);
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(246, 243, 237, 0.88);
    backdrop-filter: saturate(140%) blur(10px);
    -webkit-backdrop-filter: saturate(140%) blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .header-inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1.25rem;
    min-height: var(--header-h);
  }
  .header-brand { display: flex; align-items: center; }

  .primary-nav {
    display: flex;
    gap: 0.25rem;
    justify-content: center;
  }
  .nav-link {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-soft);
    padding: 0.45rem 0.75rem;
    border-radius: 999px;
    transition: background var(--ease), color var(--ease);
  }
  .nav-link:hover { color: var(--pine); background: var(--pine-tint); }
  .nav-link.active { color: var(--pine); background: var(--pine-tint); }

  .header-tools {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .menu-btn {
    display: none;
    width: 40px;
    height: 40px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    color: var(--ink-soft);
  }
  .menu-bar {
    width: 16px;
    height: 1.5px;
    background: currentColor;
    transition: transform var(--ease), opacity var(--ease);
  }
  .menu-open .menu-bar:first-child { transform: translateY(3.25px) rotate(45deg); }
  .menu-open .menu-bar:last-child { transform: translateY(-3.25px) rotate(-45deg); }

  .mobile-nav {
    border-top: 1px solid var(--line-soft);
    background: var(--paper);
  }
  .mobile-inner {
    display: flex;
    flex-direction: column;
    padding-top: 0.5rem;
    padding-bottom: 0.75rem;
  }
  .mobile-link {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-soft);
    padding: 0.7rem 0.25rem;
    border-bottom: 1px solid var(--line-soft);
  }
  .mobile-link:last-child { border-bottom: 0; }
  .mobile-link.active { color: var(--pine); }

  @media (max-width: 860px) {
    .header-inner { grid-template-columns: auto minmax(0, 1fr); gap: 0.75rem; }
    .primary-nav { display: none; }
    .header-tools { justify-content: flex-end; min-width: 0; }
    .menu-btn { display: inline-flex; flex-shrink: 0; }
  }
  @media (min-width: 861px) {
    .mobile-nav { display: none !important; }
  }
</style>
