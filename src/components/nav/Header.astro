---
import Logo from '~/components/brand/Logo.astro';
import SearchBar from './SearchBar.astro';
import EditToggle from './EditToggle.astro';

const path = Astro.url.pathname;
const isActive = (prefix: string) => path === prefix || path.startsWith(prefix + '/') || (prefix !== '/' && path.startsWith(prefix));
---
<header class="site-header">
  <div class="container-wide header-inner">
    <div class="header-left">
      <Logo size={32} />
    </div>
    <nav class="primary-nav" aria-label="Primary">
      <a href="/" class:list={["nav-link", { active: path === '/' }]}>Home</a>
      <a href="/resources" class:list={["nav-link", { active: isActive('/resources') }]}>Resources</a>
      <a href="/tools" class:list={["nav-link", { active: isActive('/tools') }]}>Tools</a>
    </nav>
    <div class="header-right">
      <SearchBar />
      <EditToggle />
    </div>
  </div>
</header>

<style>
  .site-header {
    background: var(--paper);
    border-bottom: 1px solid var(--line);
    position: sticky;
    top: 0;
    z-index: 40;
    backdrop-filter: saturate(140%) blur(6px);
  }
  .header-inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1.5rem;
    padding-top: 0.9rem;
    padding-bottom: 0.9rem;
  }
  .header-left { display: flex; align-items: center; }
  .primary-nav {
    display: flex;
    gap: 1.4rem;
    justify-content: center;
  }
  .nav-link {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-soft);
    padding: 0.4rem 0.2rem;
    border-bottom: 1.5px solid transparent;
  }
  .nav-link:hover { color: var(--pine); }
  .nav-link.active { color: var(--pine); border-bottom-color: var(--pine); }
  .header-right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  @media (max-width: 860px) {
    .header-inner {
      grid-template-columns: 1fr auto;
      grid-template-rows: auto auto;
      row-gap: 0.6rem;
    }
    .primary-nav {
      grid-column: 1 / -1;
      justify-content: flex-start;
      gap: 1rem;
      order: 3;
    }
    .header-right { order: 2; }
  }
</style>
