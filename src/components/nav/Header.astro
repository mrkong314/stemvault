---
import Logo from '~/components/brand/Logo.astro';
import SearchBar from './SearchBar.astro';
import ThemeToggle from './ThemeToggle.astro';
import { QUICK_TOOLS } from '~/data/tools';

const path = Astro.url.pathname;
const isActive = (prefix: string) => path === prefix || path.startsWith(prefix + '/');
const links = [
  { href: '/', label: 'Home', active: path === '/' },
  { href: '/resources', label: 'Resources', active: isActive('/resources') },
  { href: '/practice', label: 'Practice', active: isActive('/practice') },
  { href: '/tools', label: 'Tools', active: isActive('/tools') },
];
const quick = QUICK_TOOLS;
---
<header class="site-header" id="site-header">
  <div class="container-wide header-inner">
    <div class="header-brand">
      <Logo size={30} />
    </div>

    <div class="nav-group">
      <nav class="primary-nav seg" aria-label="Primary">
        {links.map(l => (
          <a href={l.href} class:list={['nav-link', { on: l.active }]} aria-current={l.active ? 'page' : undefined}>
            {l.label}
          </a>
        ))}
      </nav>
      <nav class="quick-nav" aria-label="Frequently used tools">
        {quick.map(q => (
          <a href={q.href} class="quick-link">{q.label}</a>
        ))}
      </nav>
    </div>

    <div class="header-tools">
      <SearchBar />
      <ThemeToggle />
      <button
        type="button"
        class="menu-btn"
        id="svault-menu-btn"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="svault-mobile-nav"
      >
        <span class="menu-bar" aria-hidden="true"></span>
        <span class="menu-bar" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <nav class="mobile-nav" id="svault-mobile-nav" aria-label="Primary (mobile)" hidden>
    <div class="container-wide mobile-inner">
      {links.map(l => (
        <a href={l.href} class:list={['mobile-link', { active: l.active }]}>{l.label}</a>
      ))}
      <span class="mobile-label">Frequently used</span>
      {quick.map(q => (
        <a href={q.href} class="mobile-link quick">{q.label}</a>
      ))}
    </div>
  </nav>
</header>

<script>
  const header = document.getElementById('site-header');
  const btn = document.getElementById('svault-menu-btn');
  const nav = document.getElementById('svault-mobile-nav');
  if (header && btn && nav) {
    const set = (open: boolean) => {
      nav.hidden = !open;
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      header.classList.toggle('menu-open', open);
    };
    btn.addEventListener('click', () => set(nav.hidden));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !nav.hidden) set(false);
    });
    document.addEventListener('click', (e) => {
      if (nav.hidden) return;
      if (!header.contains(e.target as Node)) set(false);
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--glass);
    backdrop-filter: var(--blur);
    -webkit-backdrop-filter: var(--blur);
    border-bottom: 1px solid var(--glass-border);
    box-shadow: inset 0 1px 0 var(--glass-edge);
  }
  .header-inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1.25rem;
    min-height: var(--header-h);
  }
  .header-brand { display: flex; align-items: center; }

  .nav-group { display: flex; align-items: center; gap: 0.6rem; justify-self: start; margin-left: 0.5rem; min-width: 0; }
  .quick-nav { display: flex; align-items: center; gap: 0.15rem; padding-left: 0.6rem; border-left: 1px solid var(--rule); }
  .quick-link {
    font-size: 0.85rem; font-weight: 500; color: var(--ink-dim);
    padding: 0.42rem 0.6rem; border-radius: 8px; white-space: nowrap;
    transition: color var(--ease), background var(--ease);
  }
  .quick-link:hover { color: var(--accent); background: var(--glass-key); }
  .nav-link { text-decoration: none; }
  .nav-link:hover { color: var(--ink); background: var(--glass); }

  .header-tools { display: flex; align-items: center; gap: 0.55rem; }

  .menu-btn {
    display: none;
    width: 38px; height: 38px;
    border: 1px solid var(--glass-border);
    border-radius: 10px;
    background: var(--glass-key);
    flex-direction: column; align-items: center; justify-content: center; gap: 5px;
    color: var(--ink);
  }
  .menu-bar { width: 16px; height: 1.5px; background: currentColor; transition: transform var(--ease); }
  .menu-open .menu-bar:first-child { transform: translateY(3.25px) rotate(45deg); }
  .menu-open .menu-bar:last-child { transform: translateY(-3.25px) rotate(-45deg); }

  .mobile-nav { border-top: 1px solid var(--glass-border); }
  .mobile-inner { display: flex; flex-direction: column; padding-top: 0.4rem; padding-bottom: 0.6rem; }
  .mobile-link { font-weight: 500; font-size: 0.95rem; color: var(--ink); padding: 0.7rem 0.25rem; border-bottom: 1px solid var(--rule); }
  .mobile-link:last-child { border-bottom: 0; }
  .mobile-link.active { color: var(--accent); font-weight: 600; }
  .mobile-label { font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-dim); padding: 0.9rem 0.25rem 0.3rem; }
  .mobile-link.quick { color: var(--ink-dim); }

  @media (max-width: 1100px) { .quick-nav { display: none; } }
  @media (max-width: 860px) {
    .header-inner { grid-template-columns: auto minmax(0, 1fr); gap: 0.75rem; }
    .nav-group { display: none; }
    .header-tools { justify-content: flex-end; min-width: 0; }
    .menu-btn { display: inline-flex; flex-shrink: 0; }
  }
  @media (min-width: 861px) { .mobile-nav { display: none !important; } }
</style>
