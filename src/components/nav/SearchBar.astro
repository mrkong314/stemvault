---
// Global search. Loads /search-index.json lazily on first focus,
// then runs case-insensitive substring matching against title + tags.
// Element ids are read by ~/scripts/search.ts.
---
<div class="search" id="svault-search">
  <svg class="search-icon" viewBox="0 0 20 20" aria-hidden="true">
    <circle cx="9" cy="9" r="6" fill="none" stroke="currentColor" stroke-width="1.6"/>
    <line x1="13.5" y1="13.5" x2="18" y2="18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
  </svg>
  <input
    type="search"
    placeholder="Search resources"
    aria-label="Search StemVault"
    autocomplete="off"
    class="search-input"
    id="svault-search-input"
  />
  <div class="search-dropdown" id="svault-search-results" hidden>
    <div class="search-empty" data-empty>Start typing to search.</div>
    <div class="search-group" data-group="applet" hidden>
      <div class="search-group-label">Applets</div>
      <ul data-list="applet"></ul>
    </div>
    <div class="search-group" data-group="file" hidden>
      <div class="search-group-label">Files</div>
      <ul data-list="file"></ul>
    </div>
    <div class="search-group" data-group="video" hidden>
      <div class="search-group-label">Videos</div>
      <ul data-list="video"></ul>
    </div>
    <div class="search-group" data-group="quiz" hidden>
      <div class="search-group-label">Quizzes</div>
      <ul data-list="quiz"></ul>
    </div>
  </div>
</div>

<script>
  import '~/scripts/search.ts';
</script>

<style>
  .search {
    position: relative;
    display: flex; align-items: center;
    background: var(--glass-key);
    border: 1px solid var(--glass-border);
    border-radius: 11px;
    padding: 0 0.8rem; height: 38px;
    width: min(320px, 100%);
    transition: border-color var(--ease), box-shadow var(--ease);
  }
  .search:focus-within { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-tint); }
  .search-icon { width: 15px; height: 15px; color: var(--ink-dim); margin-right: 0.5rem; flex-shrink: 0; }
  .search-input { flex: 1; border: none; background: transparent; outline: none; font: inherit; font-size: 0.9rem; color: var(--ink); min-width: 0; }
  .search-input::placeholder { color: var(--ink-dim); }
  .search-input::-webkit-search-cancel-button { -webkit-appearance: none; }

  .search-dropdown {
    position: absolute; top: calc(100% + 8px); right: 0;
    width: min(420px, calc(100vw - 2.5rem));
    background: var(--panel);
    border: 1px solid var(--glass-border);
    border-radius: 14px;
    box-shadow: var(--shadow-pop);
    padding: 0.4rem;
    max-height: min(60vh, 520px); overflow-y: auto; z-index: 50;
  }
  .search-empty { padding: 0.6rem 0.8rem; color: var(--ink-dim); font-size: 0.88rem; }
  .search-group + .search-group { margin-top: 0.25rem; }
  .search-group-label { font-size: 0.68rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-dim); padding: 0.5rem 0.8rem 0.2rem; }
  .search-group ul { list-style: none; margin: 0; padding: 0; }
  .search-group :global(li a) { display: flex; flex-direction: column; padding: 0.5rem 0.8rem; border-radius: 9px; color: var(--ink); }
  .search-group :global(li a:hover), .search-group :global(li a:focus-visible) { background: var(--accent-tint); color: var(--accent); }
  .search-group :global(.search-title) { font-weight: 600; font-size: 0.92rem; }
  .search-group :global(.search-sub) { font-size: 0.74rem; color: var(--ink-dim); margin-top: 2px; }

  @media (max-width: 860px) { .search { width: auto; flex: 1 1 100px; min-width: 0; max-width: 260px; } }
  @media (max-width: 480px) { .search { padding-left: 0.6rem; } .search-icon { margin-right: 0.35rem; } }
</style>
