---
// Auto / light / dark theme switch. The choice is stored in localStorage and
// applied before first paint by the inline script in BaseLayout.
---
<button type="button" class="theme-btn" id="svault-theme" aria-label="Theme: auto" title="Theme" data-mode="auto">
  <svg class="ico ico-auto" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor" stroke="none"/></svg>
  <svg class="ico ico-light" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
  <svg class="ico ico-dark" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
</button>

<script>
  const KEY = 'svault_theme';
  const ORDER = ['auto', 'light', 'dark'];
  const btn = document.getElementById('svault-theme');
  const read = () => { try { const t = localStorage.getItem(KEY); return t === 'light' || t === 'dark' ? t : 'auto'; } catch { return 'auto'; } };
  const apply = (mode: string) => {
    if (mode === 'auto') document.documentElement.removeAttribute('data-theme');
    else document.documentElement.setAttribute('data-theme', mode);
    try { if (mode === 'auto') localStorage.removeItem(KEY); else localStorage.setItem(KEY, mode); } catch {}
    if (btn) { btn.dataset.mode = mode; btn.setAttribute('aria-label', `Theme: ${mode}`); btn.title = `Theme: ${mode} (click to change)`; }
  };
  apply(read());
  btn?.addEventListener('click', () => apply(ORDER[(ORDER.indexOf(read()) + 1) % ORDER.length]));
</script>

<style>
  .theme-btn {
    width: 38px; height: 38px;
    display: inline-grid; place-items: center;
    border: 1px solid var(--glass-border);
    border-radius: 10px;
    background: var(--glass-key);
    color: var(--ink-dim);
    flex-shrink: 0;
    transition: color var(--ease), background var(--ease);
  }
  .theme-btn:hover { color: var(--accent); background: var(--glass-strong); }
  .ico { width: 18px; height: 18px; stroke: currentColor; fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; display: none; }
  .theme-btn[data-mode="auto"] .ico-auto { display: block; }
  .theme-btn[data-mode="light"] .ico-light { display: block; }
  .theme-btn[data-mode="dark"] .ico-dark { display: block; }
</style>
