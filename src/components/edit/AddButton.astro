---
import EditOnly from './EditOnly.astro';

interface Props {
  label: string;
  kind?: 'applet' | 'file' | 'tool';
  href?: string;
}
const { label, kind = 'applet', href } = Astro.props;
---
<EditOnly>
  <a
    class="add-btn"
    href={href ?? '#'}
    data-add-kind={kind}
    onclick={href ? undefined : 'event.preventDefault(); alert("Edit mode is UI-only in this build. Add the corresponding markdown file under src/content/ and rebuild.");'}
  >
    {label}
  </a>
</EditOnly>

<style>
  .add-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.35rem 0.75rem;
    border: 1px dashed var(--warn);
    border-radius: 9px;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--warn);
    background: var(--amber-tint);
    white-space: nowrap;
  }
  .add-btn:hover { background: var(--warn); color: #fff; }
</style>
