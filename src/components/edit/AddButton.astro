---
import EditOnly from './EditOnly.astro';

interface Props {
  label: string;
  kind?: 'applet' | 'file' | 'tool';
  href?: string;
}
const { label, kind = 'applet', href } = Astro.props;
---
<EditOnly>
  <a
    class="add-btn"
    href={href ?? '#'}
    data-add-kind={kind}
    onclick={href ? undefined : 'event.preventDefault(); alert("Edit mode is UI-only in this build. Add the corresponding markdown file under src/content/ and rebuild.");'}
  >
    {label}
  </a>
</EditOnly>

<style>
  .add-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.35rem 0.75rem;
    border: 1px dashed var(--amber);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--amber);
    background: var(--amber-tint);
    white-space: nowrap;
  }
  .add-btn:hover { background: var(--amber); color: #fff; }
</style>
