---
import TypeBadge from './TypeBadge.astro';
import type { ResourceEntry } from '~/lib/collections';
import { resourceHref, isExternalHref } from '~/lib/collections';

interface Props {
  resource: ResourceEntry;
}
const { resource } = Astro.props;
const { title, type, subject, yearLevel, tags, format, sourceNote, description, category } = resource.data;
const href = resourceHref(resource);
const external = isExternalHref(resource);
---
<a
  class="resource-row card"
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  data-resource
  data-type={type}
  data-category={category ?? ''}
  data-subject={subject}
  data-years={yearLevel.join(',')}
  data-tags={tags.join('|')}
  data-title={title}
>
  <span class="badge-wrap"><TypeBadge type={type} format={format} /></span>
  <span class="body">
    <span class="row-title">{title}</span>
    {description && <span class="row-desc">{description}</span>}
    <span class="row-meta">
      <span>Yr {yearLevel.join(', ')}</span>
      {sourceNote && <span>· {sourceNote}</span>}
    </span>
    {tags.length > 0 && (
      <span class="tag-list row-tags">
        {tags.slice(0, 5).map(t => <span class="tag">{t}</span>)}
      </span>
    )}
  </span>
  <span class="row-arrow" aria-hidden="true">{external ? '↗' : '→'}</span>
</a>

<style>
  .resource-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1rem;
    align-items: start;
    padding: 1rem 1.1rem;
    color: var(--ink);
  }
  .badge-wrap { padding-top: 0.15rem; }
  .body { display: flex; flex-direction: column; gap: 0.3rem; min-width: 0; }
  .row-title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    line-height: 1.2;
    transition: color var(--ease);
  }
  .resource-row:hover .row-title { color: var(--pine); }
  .row-desc {
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--ink-soft);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .row-meta {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.06em;
    color: var(--ink-mute);
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
  }
  .row-tags { margin-top: 0.2rem; }
  .row-arrow {
    font-family: var(--font-mono);
    color: var(--ink-mute);
    transition: color var(--ease), transform var(--ease);
  }
  .resource-row:hover .row-arrow { color: var(--pine); transform: translateX(2px); }
  @media (max-width: 560px) {
    .resource-row { grid-template-columns: 1fr auto; }
    .badge-wrap { grid-column: 1 / -1; }
  }
</style>
