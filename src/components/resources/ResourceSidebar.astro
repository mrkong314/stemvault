---
import { SUBJECTS } from '~/data/subjects';
import { getSubjectTopicTree, topicSlug } from '~/lib/collections';
import AddButton from '~/components/edit/AddButton.astro';

interface Props {
  activeSubject?: string;
  activeTopic?: string;
}
const { activeSubject, activeTopic } = Astro.props;
const tree = await getSubjectTopicTree();
---
<aside class="sidebar">
  <div class="sidebar-head">
    <span class="label-mono">Browse</span>
    <AddButton label="+ File" kind="file" />
  </div>
  <nav aria-label="Resource topics">
    <ul role="list" class="subject-list">
      {SUBJECTS.map(s => {
        const topics = tree[s.name] ?? [];
        const isOpen = activeSubject === s.slug;
        return (
          <li class="subject" style={`--accent: ${s.accent}`}>
            <details open={isOpen}>
              <summary class:list={['subject-row', { active: isOpen }]}>
                <a class="subject-link" href={`/resources/${s.slug}`}>
                  <span class="dot" aria-hidden="true"></span>
                  <span>{s.name}</span>
                </a>
                <span class="count">{topics.length}</span>
                <svg class="chev" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </summary>
              {topics.length > 0 ? (
                <ul role="list" class="topic-list">
                  {topics.map(t => {
                    const slug = topicSlug(t);
                    const active = isOpen && activeTopic === slug;
                    return (
                      <li>
                        <a
                          href={`/resources/${s.slug}/${slug}`}
                          class:list={['topic-link', { active }]}
                          aria-current={active ? 'page' : undefined}
                        >{t}</a>
                      </li>
                    );
                  })}
                </ul>
              ) : (
                <p class="no-topics">No topics yet.</p>
              )}
            </details>
          </li>
        );
      })}
    </ul>
  </nav>
</aside>

<style>
  .sidebar {
    position: sticky;
    top: calc(var(--header-h) + 1rem);
    max-height: calc(100dvh - var(--header-h) - 2rem);
    overflow-y: auto;
    padding-right: 0.5rem;
  }
  .sidebar-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 0.6rem;
    margin-bottom: 0.3rem;
    border-bottom: 1px solid var(--line);
  }
  .subject + .subject { border-top: 1px solid var(--line-soft); }
  .subject-row {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 0.2rem;
    cursor: pointer;
  }
  .subject-row::-webkit-details-marker { display: none; }
  .subject-link {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    flex: 1;
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--ink);
  }
  .subject-link:hover { color: var(--accent); }
  .subject-row.active .subject-link { color: var(--accent); }
  .dot {
    width: 9px; height: 9px;
    border-radius: 999px;
    background: var(--accent);
    flex-shrink: 0;
  }
  .count {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--ink-mute);
  }
  .chev { width: 14px; height: 14px; color: var(--ink-mute); transition: transform var(--ease); }
  details[open] .chev { transform: rotate(180deg); }

  .topic-list { padding: 0 0 0.6rem 1.15rem; }
  .topic-link {
    display: block;
    padding: 0.3rem 0.5rem;
    margin-left: -0.5rem;
    border-radius: var(--radius);
    font-size: 0.86rem;
    color: var(--ink-soft);
    line-height: 1.3;
  }
  .topic-link:hover { color: var(--pine); background: var(--pine-tint); }
  .topic-link.active { color: var(--pine); background: var(--pine-tint); font-weight: 500; }
  .no-topics {
    margin: 0 0 0.6rem 1.15rem;
    font-size: 0.8rem;
    color: var(--ink-mute);
  }

  @media (max-width: 880px) {
    .sidebar { position: static; max-height: none; padding-right: 0; }
  }
</style>
