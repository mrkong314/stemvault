---
import { TYPE_LABEL, FORMAT_LABEL, type ResourceType, type FileFormat } from '~/lib/types';

interface Props {
  type: ResourceType;
  format?: FileFormat;
}
const { type, format } = Astro.props;
const label = type === 'file' && format ? FORMAT_LABEL[format] : TYPE_LABEL[type];
const cls = type === 'file' && format ? `type-${format}` : `type-${type}`;
---
<span class={`type-badge ${cls}`} aria-label={`Resource type: ${label}`}>
  {label.toUpperCase()}
</span>
