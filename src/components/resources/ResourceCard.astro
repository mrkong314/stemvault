---
import TypeBadge from './TypeBadge.astro';
import type { ResourceEntry } from '~/lib/collections';
import { resourceHref, isExternalHref } from '~/lib/collections';
import { SUBJECTS } from '~/data/subjects';

interface Props {
  resource: ResourceEntry;
}
const { resource } = Astro.props;
const { title, type, subject, yearLevel, tags, description, format, category } = resource.data;
const href = resourceHref(resource);
const external = isExternalHref(resource);
const accent = SUBJECTS.find(s => s.name === subject)?.accent ?? 'var(--pine)';
---
<article
  class="resource-card card"
  style={`--accent: ${accent}`}
  data-resource
  data-type={type}
  data-category={category ?? ''}
  data-subject={subject}
  data-years={yearLevel.join(',')}
  data-tags={tags.join('|')}
  data-title={title}
>
  <a
    href={href}
    class="card-inner"
    target={external ? '_blank' : undefined}
    rel={external ? 'noopener noreferrer' : undefined}
  >
    <header class="card-head">
      <TypeBadge type={type} format={format} />
      <span class="card-years">Yr {yearLevel.join(', ')}</span>
    </header>
    <h3 class="card-title">{title}{external && <span class="ext" aria-hidden="true"> ↗</span>}</h3>
    {description && <p class="card-desc">{description}</p>}
    <footer class="card-foot">
      <span class="card-subject">{subject}</span>
      {tags.length > 0 && (
        <span class="card-tags">
          {tags.slice(0, 3).map(t => <span class="tag">{t}</span>)}
        </span>
      )}
    </footer>
  </a>
</article>

<style>
  .resource-card { position: relative; display: flex; }
  .resource-card:hover { transform: translateY(-2px); background: var(--glass-strong); border-color: var(--glass-edge); }
  .card-inner { display: flex; flex-direction: column; flex: 1; padding: 1rem 1.1rem; color: var(--ink); }
  .card-head { display: flex; justify-content: space-between; align-items: center; gap: 0.5rem; margin-bottom: 0.7rem; }
  .card-years { font-size: 0.76rem; color: var(--ink-dim); font-variant-numeric: tabular-nums; }
  .card-title { font-size: 1.05rem; margin: 0 0 0.4rem; line-height: 1.3; transition: color var(--ease); }
  .resource-card:hover .card-title { color: var(--accent); }
  .ext { font-size: 0.75em; color: var(--ink-dim); }
  .card-desc { font-size: 0.86rem; line-height: 1.45; color: var(--ink-dim); margin: 0 0 0.9rem; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .card-foot { margin-top: auto; display: flex; align-items: center; justify-content: space-between; gap: 0.6rem; flex-wrap: wrap; }
  .card-subject { font-size: 0.74rem; font-weight: 600; color: var(--accent); }
  .card-tags { display: flex; gap: 0.3rem; flex-wrap: wrap; min-width: 0; }
</style>
