---
import ResourceCard from './ResourceCard.astro';
import type { ResourceEntry } from '~/lib/collections';

interface Props {
  resources: ResourceEntry[];
  emptyMessage?: string;
  emptyFor?: string;
}
const {
  resources,
  emptyMessage = 'No resources match the current filters.',
  emptyFor = '[data-resource]',
} = Astro.props;
---
<div class="resource-grid">
  {resources.map(r => <ResourceCard resource={r} />)}
</div>
<p class="grid-empty" data-empty-for={emptyFor} hidden={resources.length > 0}>
  {emptyMessage}
</p>

<style>
  .resource-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.1rem;
  }
  @media (max-width: 960px) {
    .resource-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 620px) {
    .resource-grid { grid-template-columns: 1fr; }
  }
  .grid-empty {
    text-align: center;
    color: var(--ink-mute);
    padding: 2rem 0;
    font-style: italic;
  }
</style>
