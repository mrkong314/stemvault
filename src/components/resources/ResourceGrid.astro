---
import ResourceCard from './ResourceCard.astro';
import type { ResourceEntry } from '~/lib/collections';

interface Props {
  resources: ResourceEntry[];
  emptyMessage?: string;
  emptyFor?: string;
}
const {
  resources,
  emptyMessage = 'No resources match the current filters.',
  emptyFor = '[data-resource]',
} = Astro.props;
---
<div class="resource-grid">
  {resources.map(r => <ResourceCard resource={r} />)}
</div>
<p class="empty" data-empty-for={emptyFor} hidden={resources.length > 0}>
  {emptyMessage}
</p>

<style>
  .resource-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 0.85rem; }
</style>
