---
/**
 * Full-page shell for embedded resources (applets, quizzes).
 * The iframe fills the viewport below the site header; the page itself never
 * scrolls. Pair with `<BaseLayout fullPage>` so body/main/footer cooperate.
 *
 * Slots:
 *   about   - description, tags, prose, source link (shown in a drop-down panel)
 *   actions - extra bar controls (e.g. the edit-mode button)
 */
interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  src: string;
  title: string;
  crumbs: Crumb[];
}
const { src, title, crumbs } = Astro.props;
const hasAbout = Astro.slots.has('about');
---
<div class="applet-shell" id="applet-shell">
  <div class="applet-bar">
    <nav class="crumbs" aria-label="Breadcrumb">
      {crumbs.map((c, i) => (
        <>
          {i > 0 && <span class="crumb-sep" aria-hidden="true">/</span>}
          {c.href
            ? <a href={c.href}>{c.label}</a>
            : <span class="crumb-current" title={c.label}>{c.label}</span>}
        </>
      ))}
    </nav>
    <div class="bar-actions">
      <slot name="actions" />
      {hasAbout && (
        <button type="button" class="bar-btn" id="about-btn" aria-expanded="false" aria-controls="about-panel">
          About
        </button>
      )}
      <a class="bar-btn" href={src} target="_blank" rel="noopener noreferrer" title="Open the applet on its own in a new tab">
        New tab ↗
      </a>
      <button type="button" class="bar-btn" id="fs-btn" aria-pressed="false">
        Fullscreen
      </button>
    </div>
  </div>

  {hasAbout && (
    <div class="about-panel" id="about-panel" hidden>
      <div class="about-inner">
        <slot name="about" />
      </div>
    </div>
  )}

  <div class="frame-wrap">
    <iframe
      src={src}
      title={title}
      class="applet-frame"
      allow="fullscreen; clipboard-write"
      allowfullscreen
      referrerpolicy="no-referrer-when-downgrade"
    ></iframe>
  </div>
</div>

<style>
  .applet-shell {
    position: relative;
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    flex-direction: column;
    background: #fff;
  }
  .applet-bar {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.45rem 1rem;
    background: var(--paper);
    border-bottom: 1px solid var(--line);
  }
  .applet-bar .crumbs { margin: 0; flex-wrap: nowrap; }
  .bar-actions { display: flex; align-items: center; gap: 0.4rem; flex-shrink: 0; }
  .bar-btn {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-soft);
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.35rem 0.8rem;
    line-height: 1;
    cursor: pointer;
    white-space: nowrap;
    transition: border-color var(--ease), color var(--ease), background var(--ease);
  }
  .bar-btn:hover { border-color: var(--pine); color: var(--pine); }
  .bar-btn[aria-expanded="true"] { background: var(--pine); border-color: var(--pine); color: #fff; }

  .about-panel {
    position: absolute;
    left: 0; right: 0;
    z-index: 5;
    background: var(--surface);
    border-bottom: 1px solid var(--line);
    box-shadow: var(--shadow-pop);
    max-height: 70vh;
    overflow-y: auto;
  }
  .about-inner {
    max-width: 760px;
    margin: 0 auto;
    padding: 1.25rem 1.25rem 1.5rem;
  }

  .frame-wrap { flex: 1 1 auto; min-height: 0; background: #fff; }
  .applet-frame { display: block; width: 100%; height: 100%; border: 0; }

  .applet-shell:fullscreen { background: #fff; }
  .applet-shell.faux-fs { position: fixed; inset: 0; z-index: 100; background: #fff; }

  @media (max-width: 600px) {
    .bar-btn { padding: 0.35rem 0.6rem; }
    .applet-bar .crumbs :global(a:not(:last-of-type)) { display: none; }
  }
</style>

<script>
  const shell = document.getElementById('applet-shell');
  const fsBtn = document.getElementById('fs-btn');
  const aboutBtn = document.getElementById('about-btn');
  const aboutPanel = document.getElementById('about-panel');

  // About panel: positioned just under the bar.
  if (aboutBtn && aboutPanel && shell) {
    const bar = shell.querySelector<HTMLElement>('.applet-bar');
    const setAbout = (open: boolean) => {
      aboutPanel.hidden = !open;
      aboutBtn.setAttribute('aria-expanded', String(open));
      if (open && bar) aboutPanel.style.top = `${bar.offsetHeight}px`;
    };
    aboutBtn.addEventListener('click', () => setAbout(aboutPanel.hidden));
    document.addEventListener('click', (e) => {
      if (aboutPanel.hidden) return;
      const t = e.target as Node;
      if (!aboutPanel.contains(t) && !aboutBtn.contains(t)) setAbout(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !aboutPanel.hidden) setAbout(false);
    });
  }

  // Fullscreen, with a fill-the-window fallback.
  if (shell && fsBtn) {
    const sync = (on: boolean) => {
      fsBtn.textContent = on ? 'Exit fullscreen' : 'Fullscreen';
      fsBtn.setAttribute('aria-pressed', String(on));
    };
    const fauxOn = () => shell.classList.contains('faux-fs');
    const setFaux = (on: boolean) => {
      shell.classList.toggle('faux-fs', on);
      sync(on);
    };

    fsBtn.addEventListener('click', () => {
      if (document.fullscreenElement) {
        document.exitFullscreen();
        return;
      }
      if (fauxOn()) {
        setFaux(false);
        return;
      }
      try {
        const p = shell.requestFullscreen?.();
        if (p) p.catch(() => setFaux(true));
        else setFaux(true);
      } catch {
        setFaux(true);
      }
    });

    document.addEventListener('fullscreenchange', () => {
      sync(document.fullscreenElement === shell);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && fauxOn()) setFaux(false);
    });
  }
</script>
