---
import RecentResources from './RecentResources.astro';
import { getResources, getSubjectTopicTree } from '~/lib/collections';

const all = await getResources();
const tree = await getSubjectTopicTree();
const stats = [
  { label: 'Resources', value: all.length },
  { label: 'Applets', value: all.filter(r => r.data.type === 'applet').length },
  { label: 'Topics', value: Object.values(tree).reduce((n, ts) => n + ts.length, 0) },
];
---
<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <span class="eyebrow">Interactive teaching · Years 7–12</span>
      <h1 class="hero-title">
        A place for <em>interactive</em> teaching tools.
      </h1>
      <p class="hero-tag">
        Curated applets, quizzes, files and videos across Mathematics, Chemistry, Physics and Biology.
      </p>
      <div class="hero-actions">
        <a href="/resources" class="btn">Browse resources</a>
        <a href="/tools" class="btn btn-ghost">Open tools</a>
      </div>
      <dl class="hero-stats">
        {stats.map(s => (
          <div class="stat">
            <dd>{s.value}</dd>
            <dt>{s.label}</dt>
          </div>
        ))}
      </dl>
    </div>
    <div class="hero-aside">
      <RecentResources />
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 4rem 0 3rem;
    background:
      radial-gradient(900px 360px at 0% 0%, var(--pine-tint), transparent 60%),
      radial-gradient(600px 300px at 100% 100%, var(--amber-tint), transparent 65%);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 3rem;
    align-items: center;
  }
  .hero-title {
    font-size: clamp(2.4rem, 5vw, 4rem);
    line-height: 1.05;
    margin: 0.7rem 0 1rem;
    letter-spacing: -0.02em;
  }
  .hero-title em {
    font-style: italic;
    color: var(--pine);
  }
  .hero-tag {
    font-size: 1.08rem;
    line-height: 1.55;
    max-width: 40ch;
    color: var(--ink-soft);
    margin: 0 0 1.5rem;
  }
  .hero-actions { display: flex; gap: 0.6rem; flex-wrap: wrap; }

  .hero-stats {
    display: flex;
    gap: 2rem;
    margin: 2.25rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .stat { display: flex; flex-direction: column; }
  .stat dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.9rem;
    line-height: 1;
    color: var(--ink);
  }
  .stat dt {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--ink-mute);
    margin-top: 0.4rem;
  }

  @media (max-width: 900px) {
    .hero { padding: 2.75rem 0 2rem; }
    .hero-grid { grid-template-columns: 1fr; gap: 2rem; }
  }
</style>
