---
import { SUBJECTS } from '~/data/subjects';
import { getResources, getSubjectTopicTree } from '~/lib/collections';

const all = await getResources();
const tree = await getSubjectTopicTree();
const tiles = SUBJECTS.map(s => ({
  ...s,
  resources: all.filter(r => r.data.subject === s.name).length,
  topics: (tree[s.name] ?? []).length,
}));
---
<section class="band" aria-label="Browse by subject">
  <div class="container band-head">
    <div>
      <span class="eyebrow">Resources</span>
      <h2 class="band-title">Browse by subject</h2>
    </div>
    <a href="/resources" class="band-all">All resources →</a>
  </div>
  <div class="container band-inner">
    {tiles.map(s => (
      <a class="band-tile card" href={`/resources/${s.slug}`} style={`--accent: ${s.accent}`}>
        <span class="band-name">{s.name}</span>
        <span class="band-meta">{s.resources} resource{s.resources === 1 ? '' : 's'} · {s.topics} topic{s.topics === 1 ? '' : 's'}</span>
        <span class="band-arrow" aria-hidden="true">→</span>
      </a>
    ))}
  </div>
</section>

<style>
  .band { padding-top: 3.25rem; }
  .band-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 1rem; margin-bottom: 0.8rem; }
  .band-title { font-size: 1.35rem; margin: 0.2rem 0 0; }
  .band-all { font-size: 0.8rem; font-weight: 600; }
  .band-inner { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.75rem; }
  .band-tile {
    position: relative; display: flex; flex-direction: column; gap: 0.25rem;
    padding: 1rem 1.2rem; color: var(--ink);
  }
  .band-tile::after { content: ''; position: absolute; right: 1.1rem; top: 1.15rem; width: 10px; height: 10px; border-radius: 50%; background: var(--accent); }
  .band-name { font-size: 1.2rem; font-weight: 600; letter-spacing: -0.02em; }
  .band-meta { font-size: 0.8rem; color: var(--ink-dim); }
  .band-arrow { display: none; }
  @media (max-width: 900px) { .band-inner { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 480px) { .band-inner { grid-template-columns: 1fr; } }
</style>
