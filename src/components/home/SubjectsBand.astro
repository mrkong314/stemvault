---
import { SUBJECTS } from '~/data/subjects';
import { getResources, getSubjectTopicTree } from '~/lib/collections';

const all = await getResources();
const tree = await getSubjectTopicTree();
const tiles = SUBJECTS.map(s => ({
  ...s,
  resources: all.filter(r => r.data.subject === s.name).length,
  topics: (tree[s.name] ?? []).length,
}));
---
<section class="band" aria-label="Browse by subject">
  <div class="container band-inner">
    {tiles.map(s => (
      <a class="band-tile" href={`/resources/${s.slug}`} style={`--accent: ${s.accent}`}>
        <span class="band-name">{s.name}</span>
        <span class="band-meta">{s.resources} resource{s.resources === 1 ? '' : 's'} · {s.topics} topic{s.topics === 1 ? '' : 's'}</span>
        <span class="band-arrow" aria-hidden="true">→</span>
      </a>
    ))}
  </div>
</section>

<style>
  .band-inner {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
  }
  .band-tile {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1.1rem 1.2rem 1.1rem 1.35rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    color: var(--ink);
    overflow: hidden;
    transition: transform var(--ease), box-shadow var(--ease), border-color var(--ease);
  }
  .band-tile::before {
    content: '';
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 5px;
    background: var(--accent);
  }
  .band-tile:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-card);
    border-color: var(--accent);
    color: var(--ink);
  }
  .band-name {
    font-family: var(--font-display);
    font-size: 1.35rem;
    line-height: 1.1;
  }
  .band-meta {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.06em;
    color: var(--ink-mute);
  }
  .band-arrow {
    position: absolute;
    right: 1rem;
    top: 1rem;
    font-family: var(--font-mono);
    color: var(--accent);
    opacity: 0;
    transform: translateX(-4px);
    transition: opacity var(--ease), transform var(--ease);
  }
  .band-tile:hover .band-arrow { opacity: 1; transform: none; }
  @media (max-width: 900px) {
    .band-inner { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) {
    .band-inner { grid-template-columns: 1fr; }
  }
</style>
