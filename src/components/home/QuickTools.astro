---
import { QUICK_TOOLS } from '~/data/tools';

const ICONS: Record<string, string> = {
  calculator: '<rect x="5" y="3" width="14" height="18" rx="2"/><path d="M8 7h8M8 11h2M12 11h2M16 11h0M8 15h2M12 15h2M16 15v2"/>',
  scratchpad: '<path d="M5 4h11l3 3v13H5z"/><path d="M8 10h8M8 14h8M8 18h5"/>',
  'class-timer': '<circle cx="12" cy="13" r="8"/><path d="M12 9v4l3 2M9 2h6"/>',
};
---
<section class="quick" aria-label="Frequently used tools">
  <div class="container">
    <div class="quick-head">
      <span class="label-mono">Frequently used</span>
      <a href="/tools" class="quick-all">All tools →</a>
    </div>
    <div class="quick-grid">
      {QUICK_TOOLS.map(t => (
        <a href={t.href} class="quick-tile card">
          <span class="quick-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" set:html={ICONS[t.slug] ?? ''} />
          </span>
          <span class="quick-body">
            <span class="quick-name">{t.label}</span>
            <span class="quick-blurb">{t.blurb}</span>
          </span>
          <span class="quick-arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .quick { padding: 0 0 1.5rem; }
  .quick-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.6rem; }
  .quick-all { font-size: 0.8rem; font-weight: 600; }
  .quick-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem; }
  .quick-tile { display: flex; align-items: center; gap: 0.85rem; padding: 0.85rem 1rem; color: var(--ink); }
  .quick-icon {
    width: 42px; height: 42px; border-radius: 11px; flex-shrink: 0;
    display: grid; place-items: center;
    background: var(--accent); color: #fff;
    box-shadow: 0 2px 8px rgba(10, 132, 255, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.4);
  }
  .quick-icon svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .quick-body { display: flex; flex-direction: column; min-width: 0; }
  .quick-name { font-weight: 600; font-size: 1rem; transition: color var(--ease); }
  .quick-tile:hover .quick-name { color: var(--accent); }
  .quick-blurb { font-size: 0.78rem; color: var(--ink-dim); line-height: 1.35; }
  .quick-arrow { margin-left: auto; color: var(--ink-dim); transition: transform var(--ease), color var(--ease); }
  .quick-tile:hover .quick-arrow { color: var(--accent); transform: translateX(2px); }
  @media (max-width: 760px) { .quick-grid { grid-template-columns: 1fr; } }
</style>
