---
import { getResources, getSubjectTopicTree } from '~/lib/collections';
import { TOOLS } from '~/data/tools';

const all = await getResources();
const tree = await getSubjectTopicTree();
const stats = [
  { label: 'Resources', value: all.length },
  { label: 'Applets', value: all.filter(r => r.data.type === 'applet').length },
  { label: 'Practice banks', value: all.filter(r => r.data.category === 'practice').length },
  { label: 'Topics', value: Object.values(tree).reduce((n, ts) => n + ts.length, 0) },
  { label: 'Tools', value: TOOLS.length },
];
---
<section class="stats-band" aria-label="Site at a glance">
  <div class="container">
    <dl class="stats">
      {stats.map(s => (
        <div class="stat">
          <dd>{s.value}</dd>
          <dt>{s.label}</dt>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .stats-band { padding: 2.5rem 0 3rem; margin-top: 2rem; border-top: 1px solid var(--rule); }
  .stats { display: flex; flex-wrap: wrap; gap: 1.25rem 1.75rem; margin: 0; }
  .stat { display: flex; flex-direction: column; }
  .stat dd { margin: 0; font-size: 1.8rem; font-weight: 700; letter-spacing: -0.03em; line-height: 1; color: var(--ink); font-variant-numeric: tabular-nums; }
  .stat dt { font-size: 0.68rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-dim); margin-top: 0.35rem; }
</style>
