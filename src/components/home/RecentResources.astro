---
import TypeBadge from '~/components/resources/TypeBadge.astro';
import { getRecentResources, resourceHref, isExternalHref } from '~/lib/collections';
const recent = await getRecentResources(5);
---
<aside class="recent card">
  <div class="recent-head">
    <span class="label-mono">Recently added</span>
    <a href="/resources" class="recent-all">All resources →</a>
  </div>
  <ul role="list" class="recent-list">
    {recent.map(r => {
      const href = resourceHref(r);
      const external = isExternalHref(r);
      return (
        <li>
          <a
            href={href}
            class="recent-item"
            target={external ? '_blank' : undefined}
            rel={external ? 'noopener noreferrer' : undefined}
          >
            <TypeBadge type={r.data.type} format={r.data.format} />
            <span class="recent-body">
              <span class="recent-title">{r.data.title}</span>
              <span class="recent-meta">{r.data.subject} · Yr {r.data.yearLevel.join(', ')}</span>
            </span>
          </a>
        </li>
      );
    })}
  </ul>
</aside>

<style>
  .recent { padding: 1rem 1.1rem 0.6rem; }
  .recent-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 0.4rem;
  }
  .recent-all {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .recent-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 0;
    border-top: 1px solid var(--line-soft);
    color: var(--ink);
  }
  .recent-list li:first-child .recent-item { border-top: 0; }
  .recent-item:hover .recent-title { color: var(--pine); }
  .recent-body { display: flex; flex-direction: column; min-width: 0; }
  .recent-title {
    font-family: var(--font-display);
    font-size: 1.02rem;
    line-height: 1.25;
    transition: color var(--ease);
  }
  .recent-meta {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.06em;
    color: var(--ink-mute);
    margin-top: 2px;
  }
</style>
