---
import TypeBadge from '~/components/resources/TypeBadge.astro';
import { getRecentResources, resourceHref, isExternalHref } from '~/lib/collections';
const recent = await getRecentResources(5);
---
<aside class="recent card">
  <div class="recent-head">
    <span class="label-mono">Recently added</span>
    <a href="/resources" class="recent-all">All resources →</a>
  </div>
  <ul role="list" class="recent-list">
    {recent.map(r => {
      const href = resourceHref(r);
      const external = isExternalHref(r);
      return (
        <li>
          <a
            href={href}
            class="recent-item"
            target={external ? '_blank' : undefined}
            rel={external ? 'noopener noreferrer' : undefined}
          >
            <TypeBadge type={r.data.type} format={r.data.format} />
            <span class="recent-body">
              <span class="recent-title">{r.data.title}</span>
              <span class="recent-meta">{r.data.subject} · Yr {r.data.yearLevel.join(', ')}</span>
            </span>
          </a>
        </li>
      );
    })}
  </ul>
</aside>

<style>
  .recent { padding: 1rem 1.1rem 0.5rem; border-radius: 18px; }
  .recent-head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; margin-bottom: 0.3rem; }
  .recent-all { font-size: 0.8rem; font-weight: 600; }
  .recent-item { display: flex; align-items: center; gap: 0.75rem; padding: 0.65rem 0; border-top: 1px solid var(--rule); color: var(--ink); }
  .recent-list li:first-child .recent-item { border-top: 0; }
  .recent-item:hover .recent-title { color: var(--accent); }
  .recent-body { display: flex; flex-direction: column; min-width: 0; }
  .recent-title { font-weight: 600; font-size: 0.98rem; line-height: 1.25; transition: color var(--ease); }
  .recent-meta { font-size: 0.76rem; color: var(--ink-dim); margin-top: 2px; }
</style>
