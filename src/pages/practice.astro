---
import BaseLayout from '~/layouts/BaseLayout.astro';
import ResourceCard from '~/components/resources/ResourceCard.astro';
import { SUBJECTS } from '~/data/subjects';
import { getResourcesByCategory } from '~/lib/collections';

const banks = await getResourcesByCategory('practice');

// Group by year level and strand. Junior years split into Mathematics and Science
// (Physics, Chemistry and Biology together); VCE years (11–12) split by subject, since
// those banks follow subject-specific study designs.
type Group = { key: string; label: string; year: number; subject?: string; accent: string; href?: string; items: typeof banks };
const groups = new Map<string, Group>();
for (const r of banks) {
  const year = Math.min(...r.data.yearLevel);
  const senior = year >= 11;
  const subject = SUBJECTS.find(s => s.name === r.data.subject);
  const strand = senior ? r.data.subject : (r.data.subject === 'Mathematics' ? 'Mathematics' : 'Science');
  const key = `${year}-${strand}`;
  if (!groups.has(key)) {
    groups.set(key, {
      key,
      year,
      subject: strand,
      label: `Year ${year} ${strand}`,
      accent: strand === 'Science' ? 'var(--accent)' : subject?.accent ?? 'var(--accent)',
      href: strand === 'Science' ? '/resources' : `/resources/${subject?.slug}`,
      items: [],
    });
  }
  groups.get(key)!.items.push(r);
}
const ordered = [...groups.values()].sort((a, b) => a.year - b.year || (a.subject ?? '').localeCompare(b.subject ?? ''));
---
<BaseLayout title="Practice · StemVault" description="Self-marking practice banks for VCE and junior science and maths, grouped by subject.">
  <section class="page">
    <div class="container">
      <header class="page-head">
        <span class="eyebrow">Practice</span>
        <h1>Practice banks</h1>
        <p class="page-sub">Self-marking question sets built from success criteria, grouped by year level and subject. Each one tracks progress per criterion in the browser and generates similar questions on demand.</p>
      </header>

      {ordered.length === 0 && <p class="empty">No practice banks yet.</p>}

      {ordered.map(g => (
        <section class="group" style={`--accent: ${g.accent}`}>
          <div class="group-head">
            <h2>{g.href ? <a href={g.href}>{g.label}</a> : g.label}</h2>
            <span class="group-count">{g.items.length} bank{g.items.length === 1 ? '' : 's'}</span>
          </div>
          <div class="group-grid">
            {g.items.map(r => <ResourceCard resource={r} />)}
          </div>
        </section>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .group { margin-top: 2.25rem; }
  .group:first-of-type { margin-top: 0.5rem; }
  .group-head {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    padding-bottom: 0.6rem;
    margin-bottom: 1rem;
    border-bottom: 2px solid var(--accent);
  }
  .group-head h2 { margin: 0; font-size: 1.35rem; }
  .group-head h2 a { color: var(--ink); }
  .group-head h2 a:hover { color: var(--accent); }
  .group-count {
    font-size: 0.8rem;
    color: var(--ink-mute);
  }
  .group-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 0.9rem;
  }
</style>
