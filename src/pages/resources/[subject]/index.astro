---
import ResourceLayout from '~/layouts/ResourceLayout.astro';
import { SUBJECTS, subjectFromSlug } from '~/data/subjects';
import { getResources, getSubjectTopicTree, topicSlug, topicFor } from '~/lib/collections';

export async function getStaticPaths() {
  return SUBJECTS.map(s => ({ params: { subject: s.slug }, props: { subject: s.name } }));
}

const { subject } = Astro.props;
const subjectInfo = subjectFromSlug(Astro.params.subject!);
const tree = await getSubjectTopicTree();
const all = await getResources();
const topics = (tree[subject] ?? []).map(t => ({
  name: t,
  slug: topicSlug(t),
  count: all.filter(r => r.data.subject === subject && (
    (topicFor(r) ?? '').toLowerCase() === t.toLowerCase() ||
    r.data.tags.some(tag => tag.toLowerCase() === t.toLowerCase())
  )).length,
}));
const total = all.filter(r => r.data.subject === subject).length;
---
<ResourceLayout
  title={`${subject} · Resources · StemVault`}
  description={`Topics in ${subject}.`}
  activeSubject={subjectInfo?.slug}
>
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/resources">Resources</a>
    <span class="crumb-sep" aria-hidden="true">/</span>
    <span class="crumb-current">{subject}</span>
  </nav>
  <header class="page-head" style={`--accent: ${subjectInfo?.accent}`}>
    <span class="eyebrow accent">Subject</span>
    <div class="head-row">
      <h1 class="accent">{subject}</h1>
    </div>
    <p class="page-sub">{total} resource{total === 1 ? '' : 's'} across {topics.length} topic{topics.length === 1 ? '' : 's'}. Pick a topic to see what's in it.</p>
  </header>

  {topics.length === 0 ? (
    <p class="empty">No topics yet for {subject}. Add a resource under <code>src/content/resources/</code> with this subject.</p>
  ) : (
    <ul role="list" class="topic-grid">
      {topics.map(t => (
        <li>
          <a class="topic-link card" href={`/resources/${subjectInfo?.slug}/${t.slug}`} style={`--accent: ${subjectInfo?.accent}`}>
            <span class="topic-name">{t.name}</span>
            <span class="topic-count">{t.count}</span>
          </a>
        </li>
      ))}
    </ul>
  )}
</ResourceLayout>

<style>
  .accent { color: var(--accent); }
  .topic-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 0.75rem;
  }
  .topic-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    padding: 0.9rem 1.1rem;
    color: var(--ink);
    height: 100%;
  }
  .topic-name {
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.2;
    transition: color var(--ease);
  }
  .topic-link:hover .topic-name { color: var(--accent); }
  .topic-count {
    font-size: 0.74rem;
    font-weight: 600;
    color: var(--ink-dim);
    background: var(--glass-key);
    border: 1px solid var(--glass-border);
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    flex-shrink: 0;
  }
</style>
