---
import ResourceLayout from '~/layouts/ResourceLayout.astro';
import { SUBJECTS } from '~/data/subjects';
import { getResources, getSubjectTopicTree } from '~/lib/collections';

const all = await getResources();
const tree = await getSubjectTopicTree();
---
<ResourceLayout title="Resources · StemVault" description="Browse resources by subject and topic.">
  <header class="page-head">
    <span class="eyebrow">Library</span>
    <h1>Resources</h1>
    <p class="page-sub">Pick a subject to drill into topics. Each topic gathers the applets, quizzes, files and videos for that area.</p>
  </header>
  <div class="subject-grid">
    {SUBJECTS.map(s => {
      const topics = tree[s.name] ?? [];
      const count = all.filter(r => r.data.subject === s.name).length;
      return (
        <a class="subject-card card" href={`/resources/${s.slug}`} style={`--accent: ${s.accent}`}>
          <h2>{s.name}</h2>
          <p class="subject-count">{count} resource{count === 1 ? '' : 's'} · {topics.length} topic{topics.length === 1 ? '' : 's'}</p>
          {topics.length > 0 && (
            <ul role="list" class="tag-list">
              {topics.slice(0, 5).map(t => <li class="tag">{t}</li>)}
              {topics.length > 5 && <li class="tag">+{topics.length - 5}</li>}
            </ul>
          )}
        </a>
      );
    })}
  </div>
</ResourceLayout>

<style>
  .subject-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  .subject-card {
    position: relative;
    overflow: hidden;
    padding: 1.3rem 1.4rem 1.3rem 1.6rem;
    color: var(--ink);
  }
  .subject-card::before {
    content: '';
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 5px;
    background: var(--accent);
  }
  .subject-card:hover { border-color: var(--accent); }
  .subject-card h2 { font-size: 1.6rem; margin: 0 0 0.25rem; }
  .subject-card:hover h2 { color: var(--accent); }
  .subject-count {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    color: var(--ink-mute);
    margin: 0 0 0.8rem;
  }
  @media (max-width: 640px) {
    .subject-grid { grid-template-columns: 1fr; }
  }
</style>
