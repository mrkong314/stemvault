---
import BaseLayout from '~/layouts/BaseLayout.astro';
import ResourceEmbed from '~/components/resources/ResourceEmbed.astro';
import FullPageEmbed from '~/components/resources/FullPageEmbed.astro';
import TypeBadge from '~/components/resources/TypeBadge.astro';
import { getResources, embedSrc, topicFor, topicSlug } from '~/lib/collections';
import { TYPE_LABEL } from '~/lib/types';
import { subjectFromSlug, slugForSubject } from '~/data/subjects';

export async function getStaticPaths() {
  // Include unlisted resources so their detail pages still build (direct links work).
  const resources = await getResources({ includeUnlisted: true });
  // File entries link directly to fileUrl/externalUrl, no detail page.
  return resources
    .filter(r => r.data.type !== 'file')
    .map(r => ({
      params: { slug: r.slug },
      props: { resource: r },
    }));
}

const { resource } = Astro.props;
const { title, type, subject, yearLevel, tags, description, embedUrl, format, unlisted } = resource.data;
const { Content } = await resource.render();
const src = embedSrc(resource);
const isExternal = Boolean(embedUrl);
const subjectInfo = subjectFromSlug(slugForSubject(subject));
const topic = topicFor(resource);
const topicHref = topic ? `/resources/${subjectInfo?.slug}/${topicSlug(topic)}` : undefined;
// Applets and quizzes open edge to edge (full page); videos keep the standard page.
const fullPage = Boolean(src) && (type === 'applet' || type === 'quiz');
const sourceLabel = isExternal ? new URL(src!, 'https://x').hostname.replace('x', '') : 'Download applet';
---
<BaseLayout title={`${title} · StemVault`} description={description} noindex={unlisted} fullPage={fullPage}>
  {fullPage ? (
  <FullPageEmbed
    src={src!}
    title={title}
    crumbs={[
      { label: 'Resources', href: '/resources' },
      { label: subject, href: `/resources/${subjectInfo?.slug}` },
      { label: title },
    ]}
  >
    <div slot="about" class="about">
      <div class="head-badges">
        <TypeBadge type={type} format={format} />
        <span class="eyebrow">{subject} · Yr {yearLevel.join(', ')}</span>
      </div>
      <h1 class="about-title">{title}</h1>
      {description && <p class="lede">{description}</p>}
      {tags.length > 0 && (
        <ul role="list" class="tag-list">
          {tags.map(t => <li class="tag">{t}</li>)}
        </ul>
      )}
      <div class="prose">
        <Content />
      </div>
      <p class="meta">
        {topicHref && <a href={topicHref}>← Back to {topic}</a>}
        <a href={src} target={isExternal ? '_blank' : undefined} rel={isExternal ? 'noopener noreferrer' : undefined}>
          Source: {sourceLabel}
        </a>
      </p>
    </div>
  </FullPageEmbed>
  ) : (
  <article class="page">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/resources">Resources</a>
        <span class="crumb-sep" aria-hidden="true">/</span>
        <a href={`/resources/${subjectInfo?.slug}`}>{subject}</a>
        {topicHref && (
          <>
            <span class="crumb-sep" aria-hidden="true">/</span>
            <a href={topicHref}>{topic}</a>
          </>
        )}
        <span class="crumb-sep" aria-hidden="true">/</span>
        <span class="crumb-current">{title}</span>
      </nav>
      <header class="page-head">
        <div class="head-badges">
          <TypeBadge type={type} format={format} />
          <span class="eyebrow">{subject} · Yr {yearLevel.join(', ')}</span>
        </div>
        <div class="head-row">
          <h1>{title}</h1>
        </div>
        {description && <p class="page-sub">{description}</p>}
        {tags.length > 0 && (
          <ul role="list" class="tag-list tags">
            {tags.map(t => <li class="tag">{t}</li>)}
          </ul>
        )}
      </header>

      {src ? (
        <ResourceEmbed src={src} title={title} />
      ) : (
        <p class="empty">No embeddable source for this resource.</p>
      )}

      <footer class="resource-foot">
        <div class="meta">
          <span class="label-mono">Source</span>
          {src && (
            <a href={src} target={isExternal ? '_blank' : undefined} rel={isExternal ? 'noopener noreferrer' : undefined}>
              {sourceLabel}{isExternal && ' ↗'}
            </a>
          )}
        </div>
        <div class="prose">
          <Content />
        </div>
      </footer>
    </div>
  </article>
  )}
</BaseLayout>

<style>
  .head-badges {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-bottom: 0.3rem;
  }
  .page-head h1 { max-width: 24ch; }
  .tags { margin-top: 1rem; }
  .resource-foot {
    margin-top: 1.5rem;
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .meta {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    font-size: 0.88rem;
    color: var(--ink-soft);
  }
  .meta a:hover { text-decoration: underline; }

  /* About panel (full-page mode) */
  .about-title { font-size: 1.4rem; margin: 0.4rem 0 0.5rem; }
  .about .lede { font-size: 0.95rem; color: var(--ink-soft); margin: 0 0 0.8rem; }
  .about .prose :global(p) { font-size: 0.92rem; margin: 0.6rem 0; }
  .about .meta {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 1.2rem;
    margin: 0.9rem 0 0;
    padding-top: 0.8rem;
    border-top: 1px solid var(--line);
  }
  @media (max-width: 760px) {
    .resource-foot { grid-template-columns: 1fr; }
  }
</style>
