---
import BaseLayout from '~/layouts/BaseLayout.astro';
---
<BaseLayout title="Not found · StemVault" noindex>
  <section class="not-found">
    <div class="container inner">
      <span class="eyebrow">404</span>
      <h1>That page isn't in the vault.</h1>
      <p class="page-sub">The link may have moved or the resource has been retired. Try the library or jump back home.</p>
      <div class="actions">
        <a href="/" class="btn">Home</a>
        <a href="/resources" class="btn btn-ghost">Browse resources</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found { padding: 5rem 0 4rem; }
  .inner { text-align: center; max-width: 560px; }
  .inner h1 { margin: 0.6rem 0 0.8rem; }
  .inner .page-sub { margin: 0 auto 1.5rem; }
  .actions { display: inline-flex; gap: 0.6rem; flex-wrap: wrap; justify-content: center; }
</style>
