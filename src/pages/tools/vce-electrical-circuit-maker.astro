---
import BaseLayout from '~/layouts/BaseLayout.astro';
import FullPageEmbed from '~/components/resources/FullPageEmbed.astro';

const title = 'VCE Electrical Circuit Maker';
const description = 'Exam-style circuit diagram builder for VCE Physics. Drag in cells, resistors, lamps, switches, meters and semiconductors, wire them up, and read off the circuit analysis. Export to PNG or SVG.';
---
<BaseLayout title={`${title} · Tools · StemVault`} description={description} fullPage>
  <FullPageEmbed
    src="/applets/vce-electrical-circuit-maker.html"
    title={title}
    crumbs={[{ label: 'Tools', href: '/tools' }, { label: title }]}
  >
    <div slot="about" class="about">
      <span class="eyebrow">Tool</span>
      <h1 class="about-title">{title}</h1>
      <p class="lede">{description}</p>
    </div>
  </FullPageEmbed>
</BaseLayout>

<style>
  .about-title { font-size: 1.5rem; margin: 0.4rem 0 0.5rem; }
  .lede { font-size: 0.95rem; color: var(--ink-soft); margin: 0; }
</style>
