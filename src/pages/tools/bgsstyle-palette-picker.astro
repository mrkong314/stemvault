---
import BaseLayout from '~/layouts/BaseLayout.astro';

const bgsPalette = [
  { name: 'BGS Blue', value: '#004EA0' },
  { name: 'BGS Red', value: '#E01933' },
  { name: 'BGS Red Alt', value: '#DC0024' },
  { name: 'BGS Red PMS', value: '#E31933' },
  { name: 'Armstrong', value: '#F1F2F2' },
  { name: 'Crowther', value: '#FFC20E' },
  { name: 'Dixon', value: '#2484C6' },
  { name: 'Fairweather', value: '#F47B25' },
  { name: 'Hancock', value: '#0DB14B' },
  { name: 'Melville', value: '#36454F' },
  { name: 'Rofe', value: '#5C2D91' },
  { name: 'School Red', value: '#ED1B2F' },
  { name: 'White', value: '#FFFFFF' },
  { name: 'Black', value: '#000000' },
  { name: 'Placeholder grey', value: '#808080' },
];
---
<BaseLayout title="BGS Style Palette Picker · Tools · StemVault">
  <section class="page">
    <div class="container">
      <nav class="crumbs">
        <a href="/tools">Tools</a>
      </nav>
      <header class="page-head">
        <span class="eyebrow">Tool</span>
        <h1>BGS Style Palette Picker</h1>
        <p class="page-sub">Sample any colour and view a small accessible preview. The Brighton Grammar School brand palette is below.</p>
      </header>

      <div class="picker">
        <label class="picker-label" for="picker-input">Pick a colour</label>
        <div class="picker-row">
          <input id="picker-input" type="color" value="#004EA0" />
          <input id="picker-hex" type="text" value="#004EA0" maxlength="9" aria-label="Hex value" />
          <button id="picker-copy" type="button" class="copy-btn">Copy</button>
        </div>
        <div class="preview" id="picker-preview" style="--c: #004EA0">
          <div class="preview-block"><span>Background</span></div>
          <div class="preview-text">The quick brown fox jumps over the lazy dog.</div>
          <div class="preview-text mono">CONTRAST · <span id="picker-ratio">-</span> on white</div>
        </div>
      </div>

      <h2 class="brand-h">BGS palette</h2>
      <ul class="swatch-grid">
        {bgsPalette.map(s => (
          <li>
            <button type="button" class="swatch" data-hex={s.value} style={`--c: ${s.value}`} aria-label={`Use ${s.name}`}>
              <span class="swatch-chip"></span>
              <span class="swatch-name">{s.name}</span>
              <span class="swatch-hex">{s.value}</span>
            </button>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<script>
  const input = document.getElementById('picker-input') as HTMLInputElement;
  const hex = document.getElementById('picker-hex') as HTMLInputElement;
  const copyBtn = document.getElementById('picker-copy') as HTMLButtonElement;
  const preview = document.getElementById('picker-preview') as HTMLElement;
  const ratioEl = document.getElementById('picker-ratio') as HTMLElement;

  function normalizeHex(v: string): string | null {
    let h = v.trim().replace(/^#/, '');
    if (/^[0-9a-f]{3}$/i.test(h)) h = h.split('').map(c => c + c).join('');
    if (!/^[0-9a-f]{6}$/i.test(h)) return null;
    return '#' + h.toLowerCase();
  }

  function srgb(v: number): number {
    const s = v / 255;
    return s <= 0.03928 ? s / 12.92 : Math.pow((s + 0.055) / 1.055, 2.4);
  }
  function luminance(hex: string): number {
    const n = parseInt(hex.slice(1), 16);
    return 0.2126 * srgb((n >> 16) & 255) + 0.7152 * srgb((n >> 8) & 255) + 0.0722 * srgb(n & 255);
  }
  function contrast(a: string, b: string): number {
    const la = luminance(a), lb = luminance(b);
    const [hi, lo] = la > lb ? [la, lb] : [lb, la];
    return (hi + 0.05) / (lo + 0.05);
  }

  function update(value: string) {
    const norm = normalizeHex(value);
    if (!norm) return;
    input.value = norm;
    hex.value = norm;
    preview.style.setProperty('--c', norm);
    ratioEl.textContent = contrast(norm, '#ffffff').toFixed(2) + ':1';
  }

  input.addEventListener('input', () => update(input.value));
  hex.addEventListener('change', () => update(hex.value));
  copyBtn.addEventListener('click', async () => {
    await navigator.clipboard.writeText(hex.value);
    copyBtn.textContent = 'Copied';
    setTimeout(() => (copyBtn.textContent = 'Copy'), 1200);
  });

  document.querySelectorAll<HTMLButtonElement>('.swatch').forEach(btn => {
    btn.addEventListener('click', () => update(btn.dataset.hex ?? '#000000'));
  });

  update(input.value);
</script>

<style>
  .page { padding: 2.5rem 0 4rem; }
  .crumbs {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--ink-mute);
    margin-bottom: 1rem;
  }
  .crumbs a { color: var(--ink-mute); }
  .crumbs a:hover { color: var(--pine); }
  .page-head h1 { margin: 0.4rem 0 0.6rem; }
  .page-sub { color: var(--ink-soft); margin: 0 0 1.5rem; max-width: 60ch; }

  .picker {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    box-shadow: var(--shadow-soft);
  }
  .picker-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--ink-mute);
    margin-bottom: 0.6rem;
  }
  .picker-row {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    margin-bottom: 1.2rem;
  }
  .picker-row input[type="color"] {
    width: 56px; height: 40px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--paper);
    padding: 0;
  }
  .picker-row input[type="text"] {
    flex: 1;
    min-width: 0;
    padding: 0.5rem 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.95rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--paper);
    outline: none;
  }
  .picker-row input[type="text"]:focus { border-color: var(--pine); background: #fff; }
  .copy-btn {
    background: var(--pine);
    color: #fff;
    border: none;
    padding: 0.55rem 1rem;
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .copy-btn:hover { background: var(--pine-deep); }

  .preview {
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: 1rem;
    align-items: center;
    background: var(--paper);
    border-radius: var(--radius);
    padding: 1rem;
  }
  .preview-block {
    width: 100%; height: 60px;
    background: var(--c);
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .preview-text { color: var(--c); font-size: 1.05rem; }
  .preview-text.mono {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink-mute);
    grid-column: 1 / -1;
  }
  .preview-text.mono span { color: var(--c); font-weight: 700; }

  .brand-h {
    margin: 2.5rem 0 1rem;
    font-size: 1.1rem;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--ink-mute);
  }
  .swatch-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.7rem;
  }
  .swatch {
    display: grid;
    grid-template-columns: 32px 1fr;
    grid-template-rows: auto auto;
    align-items: center;
    column-gap: 0.6rem;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 0.6rem 0.8rem;
    text-align: left;
    cursor: pointer;
    transition: border-color 0.12s;
  }
  .swatch:hover { border-color: var(--pine); }
  .swatch-chip {
    grid-row: 1 / 3;
    width: 32px; height: 32px;
    border-radius: 6px;
    background: var(--c);
    border: 1px solid rgba(0, 0, 0, 0.08);
  }
  .swatch-name { font-size: 0.85rem; font-weight: 500; }
  .swatch-hex { font-family: var(--font-mono); font-size: 0.7rem; color: var(--ink-mute); }
  @media (max-width: 720px) {
    .swatch-grid { grid-template-columns: repeat(2, 1fr); }
    .preview { grid-template-columns: 1fr; }
  }
</style>
