---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { TOOLS } from '~/data/tools';
---
<BaseLayout title="Tools · StemVault" description="Standalone tools for teaching workflows.">
  <section class="page">
    <div class="container">
      <header class="page-head">
        <span class="eyebrow">Workshop</span>
        <div class="head-row">
          <h1>Tools</h1>
        </div>
        <p class="page-sub">General-purpose utilities that aren't tied to a single subject: timers, pickers, calculators and exam-style diagram builders.</p>
      </header>
      <ul role="list" class="tool-grid">
        {TOOLS.map((t, i) => (
          <li>
            <a class="tool-card card" href={t.href}>
              <span class="tool-index">{String(i + 1).padStart(2, '0')}</span>
              <h2>{t.title}</h2>
              <p>{t.description}</p>
              <span class="tool-open">Open <span aria-hidden="true">→</span></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .tool-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1rem;
  }
  .tool-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.3rem 1.4rem 1.2rem;
    color: var(--ink);
  }
  .tool-index {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--ink-dim);
    margin-bottom: 0.6rem;
  }
  .tool-card h2 { font-size: 1.3rem; margin: 0 0 0.4rem; transition: color var(--ease); }
  .tool-card:hover h2 { color: var(--pine); }
  .tool-card p { margin: 0 0 1rem; color: var(--ink-soft); font-size: 0.92rem; line-height: 1.5; }
  .tool-open {
    margin-top: auto;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--pine);
  }
</style>
