---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/home/Hero.astro';
import SubjectsBand from '~/components/home/SubjectsBand.astro';
import QuickTools from '~/components/home/QuickTools.astro';
import FilterPanel from '~/components/filters/FilterPanel.astro';
import ResourceGrid from '~/components/resources/ResourceGrid.astro';
import { getResources } from '~/lib/collections';

const resources = await getResources();
---
<BaseLayout title="StemVault · interactive teaching tools">
  <Hero />
  <QuickTools />
  <SubjectsBand />

  <section class="browse" id="browse">
    <div class="container">
      <header class="section-head">
        <span class="eyebrow">Library</span>
        <h2>Browse everything</h2>
        <p class="page-sub">Filter by subject, year level, type and tags. Applets and quizzes open full screen; files download directly.</p>
      </header>
      <div class="browse-layout">
        <FilterPanel target="[data-resource]" />
        <div class="browse-grid">
          <ResourceGrid resources={resources} />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .browse { padding: 4rem 0 2rem; }
  .section-head { margin-bottom: 1.5rem; }
  .section-head h2 { margin: 0.4rem 0 0.4rem; }
  .browse-layout {
    display: grid;
    grid-template-columns: 250px minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
  }
  .browse-grid { min-width: 0; }
  @media (max-width: 880px) {
    .browse-layout { grid-template-columns: 1fr; gap: 1.25rem; }
  }
</style>
