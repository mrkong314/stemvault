---
import '~/styles/global.css';
import Header from '~/components/nav/Header.astro';
import Footer from '~/components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Edge-to-edge mode: content fills the viewport below the header, no page scroll, no footer. */
  fullPage?: boolean;
}
const {
  title = 'StemVault · interactive teaching tools',
  description = 'A place for interactive teaching tools and STEM resources.',
  noindex = false,
  fullPage = false,
} = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL('/og-image.png', Astro.site).href : '/og-image.png';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#eef1f6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0c" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="apple-mobile-web-app-title" content="StemVault" />
    <meta name="application-name" content="StemVault" />
    <script is:inline>
      // Apply a pinned theme before first paint so there is no flash. "auto" follows the system.
      try { var t = localStorage.getItem('svault_theme'); if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t); } catch (e) {}
    </script>
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="StemVault" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
  </head>
  <body class:list={{ 'full-page': fullPage }}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    top: -100px;
    left: 1rem;
    z-index: 100;
    background: var(--accent);
    color: #fff;
    padding: 0.5rem 0.9rem;
    border-radius: 0 0 var(--radius) var(--radius);
    font-size: 0.8rem;
    font-weight: 600;
  }
  .skip-link:focus { top: 0; color: #fff; }
</style>
